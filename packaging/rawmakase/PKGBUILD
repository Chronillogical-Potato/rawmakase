# Maintainer: pch <https://github.com/pch>
pkgname=rawmakase
pkgver=0.1.7
pkgrel=1
pkgdesc='A fast, non-destructive RAW photo developer'
arch=('x86_64')
url='https://github.com/pch/rawmakase'
license=('MIT')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'lcms2' 'libraw>=0.22' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd')
optdepends=('xdg-desktop-portal: native file dialogs')
makedepends=('cargo' 'pkgconf')
# makepkg's LTO flags turn bundled C code (SQLite, LibRaw glue) into GCC bytecode rustc
# cannot link.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/pch/rawmakase/archive/refs/tags/v$pkgver.tar.gz")
# The release workflow publishes this file with the real checksum filled in.
sha256sums=('SKIP')

prepare() {
  cd "rawmakase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "rawmakase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "rawmakase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "rawmakase-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr PKGNAME="$pkgname"
}
